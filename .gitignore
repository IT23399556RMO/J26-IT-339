# ==========================================
# Root .gitignore for J26-IT-339
# Server (Node/Express/Prisma/TypeScript) & Client (Flutter/Dart)
# ==========================================

# Environment & Secret Files (NEVER commit secrets to GitHub)
.env
.env.local
.env.development
.env.test
.env.production
.env.*
!.env.example
!**/.env.example

# Node.js / Server Dependencies & Logs
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build Outputs
dist/
build/
out/
.next/
*.tsbuildinfo
next-env.d.ts

# Prisma / Local Database files
*.db
*.db-journal

# Certificates & Private Keys
*.pem
*.key
*.keystore
*.jks

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
ephemeral/
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/ios/Flutter/.last_build_id
coverage/

# Android Specific
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/GeneratedPluginRegistrant.java
**/key.properties

# iOS / macOS Specific
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/macos/Pods/
**/macos/.symlinks/
**/macos/Flutter/ephemeral/
*.mode1v3
*.mode2v3
*.pbxuser
*.perspectivev3
xcuserdata/

# Flutter Symbols & Maps
app.*.symbols
app.*.map.json
.widget_preview/

# Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
setup.txt
*.iml
*.ipr
*.iws
.idea/
.vscode/
*.swp
