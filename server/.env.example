# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Database Connection (Prisma)
# Example PostgreSQL: postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public
# Example MySQL: mysql://USER:PASSWORD@localhost:3306/DATABASE
# Example MongoDB: mongodb://USER:PASSWORD@localhost:27017/DATABASE?authSource=admin
DATABASE_URL="postgresql://username:password@localhost:5432/dbname?schema=public"

# CORS Configuration
CLIENT_URL=http://localhost:3000
